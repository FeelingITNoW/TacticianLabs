# The web app for Railway (railway.json points here). Dev uses Dockerfile.node instead.
FROM node:22-slim AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
RUN npm run build

FROM node:22-slim
WORKDIR /app
ENV NODE_ENV=production
COPY package*.json ./
RUN npm ci --omit=dev && npm cache clean --force
COPY --from=build /app/dist ./dist
COPY server.mjs ./
USER node
# Railway sets PORT
EXPOSE 3000
CMD ["node", "server.mjs"]
