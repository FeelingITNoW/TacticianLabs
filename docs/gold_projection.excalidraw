   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Spending: presets spend nothing, so their gold is a ceiling; a custom Scenario spends only what it enters.   HP: win and loss are bounds on income, not forecasts.\nBoard units: only a Scenario's own gold entries pay for them.   The comp: every comp gets the same projection; only the roll_odds step uses its carries.",
   "originalText": "Spending: presets spend nothing, so their gold is a ceiling; a custom Scenario spends only what it enters.   HP: win and loss are bounds on income, not forecasts.\nBoard units: only a Scenario's own gold entries pay for them.   The comp: every comp gets the same projection; only the roll_odds step uses its carries.",
   "fontSize": 14,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
