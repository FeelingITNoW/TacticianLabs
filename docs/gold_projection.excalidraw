   "versionNonce": 1185088796,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "The projection reports the end round's planning phase, before its fight, so that fight's result is left out.",
   "originalText": "The projection reports the end round's planning phase, before its fight, so that fight's result is left out.",
