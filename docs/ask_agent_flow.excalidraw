			"text": "6a Gemini · generate_content(model, contents, config)",
			"originalText": "6a Gemini · generate_content(model, contents, config)",
			"fontSize": 20,
			"fontFamily": 2,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"lineHeight": 1.15,
			"autoResize": true,
