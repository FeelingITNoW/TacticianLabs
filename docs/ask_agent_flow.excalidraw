		{
			"id": "t-97",
			"type": "text",
			"x": 2016,
			"y": 1567.6,
			"width": 859.728515625,
			"height": 336,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 1,
			"strokeStyle": "solid",
			"roughness": 0,
			"opacity": 100,
			"groupIds": [
				"g-94"
			],
			"frameId": null,
			"roundness": null,
			"seed": 618979931,
			"version": 2,
