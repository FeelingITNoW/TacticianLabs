   "text": "Answer {\n  text: str,                         // Gemini's \n  final markdown\n  queries: list[str],                // SELECTs that \n  were allowed to run\n  rows: list[dict],                  // last good sql\n   result\n  model_calls: list[ModelCall],\n  sql_runs: list[SqlRun],\n  roll_odds: list[dict],             // full \n  roll_odds dicts\n  roll_odds_runs: list[RollOddsRun],\n  gold_projections: list[dict],      // full \n  gold_projection dicts\n  gold_projection_runs: list[...],\n  model: str, prompt_sha256: str }",
