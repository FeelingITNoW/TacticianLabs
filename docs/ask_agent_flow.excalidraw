			"x": 2536,
			"y": 2624,
			"width": 446.7216796875,
			"height": 201.60000000000002,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 1,
			"strokeStyle": "solid",
