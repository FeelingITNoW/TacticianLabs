			"text": "internals · _run_guarded(client, query, log, run)",
			"originalText": "internals · _run_guarded(client, query, log, run)",
			"fontSize": 20,
			"fontFamily": 2,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"lineHeight": 1.15,
			"autoResize": true,
			"index": "b0D",
