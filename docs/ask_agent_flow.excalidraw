   "link": null,
   "locked": false,
   "text": "answer = Answer(text='', model=$GEMINI_SQL_MODEL)\nsystem = build_context(client)\n  prompt.INSTRUCTIONS + column glossary + live \n  columns of each of the 15 current_* VIEWS \n  (INFORMATION_SCHEMA)\n  sha256 \u2192 answer.prompt_sha256\ncontents = build_contents(question, history)\n  = [ types.Content(role, parts=[Part(text)]) for \n  last 6 turns ] + [ Content('user', question) ]\nconfig = GenerateContentConfig(\n  system_instruction=system,\n  tools=[sql, roll_odds, gold_projection],       // \n  plain Python functions; Gemini builds each schema \n  from the signature + docstring\n  automatic_function_calling=disabled )          // \n  so every call's tokens are counted",
   "originalText": "answer = Answer(text='', model=$GEMINI_SQL_MODEL)\nsystem = build_context(client)\n  prompt.INSTRUCTIONS + column glossary + live \n  columns of each of the 15 current_* VIEWS \n  (INFORMATION_SCHEMA)\n  sha256 \u2192 answer.prompt_sha256\ncontents = build_contents(question, history)\n  = [ types.Content(role, parts=[Part(text)]) for \n  last 6 turns ] + [ Content('user', question) ]\nconfig = GenerateContentConfig(\n  system_instruction=system,\n  tools=[sql, roll_odds, gold_projection],       // \n  plain Python functions; Gemini builds each schema \n  from the signature + docstring\n  automatic_function_calling=disabled )          // \n  so every call's tokens are counted",
   "fontSize": 14,
