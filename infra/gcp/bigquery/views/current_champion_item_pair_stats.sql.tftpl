SELECT s.*, ch.name AS champion_name, a.name AS item_a_name, b.name AS item_b_name
FROM `${project}.${dataset}.champion_item_pair_stats` AS s
LEFT JOIN `${project}.${dataset}.champions` AS ch ON ch.api_name = s.champion
LEFT JOIN `${project}.${dataset}.items` AS a ON a.api_name = s.item_a
LEFT JOIN `${project}.${dataset}.items` AS b ON b.api_name = s.item_b
WHERE s.patch = (SELECT patch FROM `${project}.${dataset}.patch_totals` ORDER BY last_played_at DESC LIMIT 1)
