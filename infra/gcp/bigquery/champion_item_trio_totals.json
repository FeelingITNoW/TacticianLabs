  {"name": "champion", "type": "STRING", "mode": "REQUIRED"},
  {"name": "item_a", "type": "STRING", "mode": "REQUIRED", "description": "The lowest api name of the three items a unit held (exactly three)"},
  {"name": "item_b", "type": "STRING", "mode": "REQUIRED", "description": "The middle api name; copies of one item repeat"},
  {"name": "item_c", "type": "STRING", "mode": "REQUIRED", "description": "The highest api name"},
  {"name": "boards", "type": "INT64", "mode": "REQUIRED", "description": "Boards (one player in one match) that had it; summed over the patch"},
  {"name": "matches", "type": "INT64", "mode": "REQUIRED", "description": "Distinct matches where at least one board had it"},
  {"name": "placement_sum", "type": "INT64", "mode": "REQUIRED", "description": "Sum of those boards' placements (1-8)"},
  {"name": "top4_count", "type": "INT64", "mode": "REQUIRED", "description": "Boards that placed 1-4"},
  {"name": "win_count", "type": "INT64", "mode": "REQUIRED", "description": "Boards that placed 1st"},
  {"name": "updated_at", "type": "TIMESTAMP"}
